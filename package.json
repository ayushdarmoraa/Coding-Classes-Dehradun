{
  "name": "coding-classes-dehradun",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "psi": "node scripts/psi-check.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "check:content": "node scripts/content-qa.mjs",
    "test:content": "node --test scripts/content-qa.test.mjs",
    "test:courses": "node --test scripts/course-model.test.mjs scripts/course-detail.test.mjs scripts/course-hub.test.mjs scripts/online-course.test.mjs",
    "test:enquiry": "node --test scripts/enquiry.test.mjs",
    "test:motion": "node --test scripts/reveal-on-scroll.test.mjs",
    "test:lab": "node --test scripts/lab-foundation.test.mjs scripts/lab-mission.test.mjs scripts/lab-workspace.test.mjs scripts/lighthouse-config.test.mjs",
    "test:lab:e2e": "playwright test --config playwright.config.ts",
    "test:pr3": "npm run test:lab && node --test scripts/navigation.test.mjs",
    "test:guides": "node --test scripts/guides.test.mjs",
    "test:projects": "node --test scripts/projects.test.mjs",
    "test:outcomes": "node --test scripts/outcomes.test.mjs",
    "test": "npm run test:motion && npm run test:pr3 && npm run test:guides && npm run test:projects && npm run test:outcomes && npm run test:enquiry",
    "check:analytics": "node ./scripts/check-analytics.js",
    "gsc:submit": "node scripts/gsc-submit-sitemap.mjs",
    "gsc:submit:domain": "node scripts/gsc-submit-sitemap-domain.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@lezer/javascript": "^1.5.6",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "14.7.1",
    "gray-matter": "^4.0.3",
    "lenis": "1.3.27",
    "next": "^14.2.35",
    "nodemailer": "^6.10.1",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "24.3.0",
    "@types/nodemailer": "^6.4.19",
    "@types/react": "18.3.24",
    "autoprefixer": "10.4.16",
    "critters": "^0.0.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "glob": "^10.5.0",
    "googleapis": "^160.0.0",
    "postcss": "8.5.32",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwindcss": "3.4.4",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
